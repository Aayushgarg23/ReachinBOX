# Backend Environment Variables
# Copy this to .env and fill in values

# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database (MySQL)
DATABASE_URL="mysql://reachinbox:reachinbox123@localhost:3306/reachinbox"

# Redis
REDIS_URL=redis://localhost:6379

# BullMQ Worker
WORKER_CONCURRENCY=5
MIN_DELAY_MS=1000

# Rate Limiting
MAX_EMAILS_PER_HOUR_PER_SENDER=100

# Auth (shared secret between frontend Next.js server and this backend)
API_SECRET=change-this-to-a-secure-random-string-in-production

# NextAuth (used for validation, must match frontend)
NEXTAUTH_SECRET=your-nextauth-secret-here
