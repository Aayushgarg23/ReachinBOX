// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  name      String?
  image     String?    @db.Text
  googleId  String?    @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  campaigns Campaign[]

  @@map("users")
}

model Sender {
  id               String     @id @default(uuid())
  email            String     @unique
  name             String
  smtpHost         String
  smtpPort         Int        @default(587)
  smtpUser         String
  smtpPass         String
  maxEmailsPerHour Int        @default(100)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  campaigns        Campaign[]
  emails           Email[]

  @@map("senders")
}

model Campaign {
  id             String   @id @default(uuid())
  userId         String
  senderId       String
  subject        String   @db.VarChar(500)
  body           String   @db.LongText
  startTime      DateTime
  delayBetweenMs Int      @default(0)
  hourlyLimit    Int      @default(100)
  status         String   @default("active") // active | paused | completed
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender Sender @relation(fields: [senderId], references: [id], onDelete: Cascade)
  emails Email[]

  @@map("campaigns")
}

model Email {
  id            String    @id @default(uuid())
  campaignId    String
  senderId      String
  recipient     String
  subject       String    @db.VarChar(500)
  body          String    @db.LongText
  status        EmailStatus @default(pending)
  scheduledTime DateTime
  sentTime      DateTime?
  errorMessage  String?   @db.Text
  attempts      Int       @default(0)
  etherealUrl   String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sender   Sender   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([campaignId, recipient])
  @@index([status])
  @@index([scheduledTime])
  @@index([senderId, status])
  @@map("emails")
}

enum EmailStatus {
  pending
  queued
  processing
  sent
  failed
  rescheduled
}
